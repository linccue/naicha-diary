<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- ================= 左侧区域 ================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 猫咪图片 -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/widget_cat"
            android:scaleType="fitCenter" />

        <!-- 左侧文字块（上下拆分） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <!-- 左上半部分：MONTH（固定高 18dp，居中对齐） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1C1C1E"
                    android:paddingStart="5dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="1dp"
                    android:text="MONTH"
                    android:textColor="#CCFF00"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 左下半部分：数字和“杯”（固定高 28dp，底部对齐） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_month_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="2dp"
                    android:text="杯"
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 中间竖线 ================= -->
    <TextView
        android:layout_width="1dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:background="#E0E0E0"
        android:layout_gravity="center_vertical" />

    <!-- ================= 右侧区域 ================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6"
        android:orientation="vertical">

        <!-- 右上半部分：绿点+日期（固定高 18dp，居中对齐） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <TextView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_green" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:text="10月26日"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 右下半部分：品牌名称（固定高 28dp，底部对齐） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- 这里放一个 13dp 的透明占位块（7dp绿点 + 6dp margin = 13dp），完美实现左边起点对齐 -->
            <View
                android:layout_width="13dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tv_drink_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="CoCo都可"
                android:textColor="#1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
